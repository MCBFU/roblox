function checkSyntaxLive() {
    var code = document.getElementById('inputCode').value;
    if (!code.trim()) { document.getElementById('syntaxCheck').classList.remove('visible'); return; }
    var result = checkSyntax(code);
    var box = document.getElementById('syntaxCheck');
    var icon = document.getElementById('syntaxIcon');
    var msg = document.getElementById('syntaxMsg');
    box.classList.add('visible');
    if (result.valid) {
        box.classList.remove('visible');
    } else {
        box.classList.remove('ok'); box.classList.add('err');
        icon.textContent = '\u2717'; msg.innerHTML = result.errors.slice(0, 6).join('<br>') + (result.errors.length > 6 ? '<br>...还有 ' + (result.errors.length - 6) + ' 个问题' : '');
    }
}

