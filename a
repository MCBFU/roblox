    } else {
        document.getElementById('captchaTitle').textContent = '验证通过';
        document.getElementById('captchaDesc').textContent = '人机验证已完成，可以开始混淆';
        document.getElementById('obfBtn').disabled = false;
        setStatus('验证通过，可以开始混淆', 'success');
    }
}

