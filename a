function loadSample() {
    var s='-- 测试混淆\nprint("Hello World")\nprint(123)\nprint("GetService Test")\n\nlocal x = 42\nlocal y = x * 2\nprint("Result: " .. y)\n\nfor i = 1, 3 do\n    print("Loop: " .. i)\nend\n\nlocal function add(a, b)\n    return a + b\nend\n\nprint(add(10, 20))';
    document.getElementById('inputCode').value=s;
    document.getElementById('resultPanel').classList.add('hidden');
    updateStats();checkSyntaxLive();setStatus('示例已加载');
}
function clearInput() {
    document.getElementById('inputCode').value='';
    document.getElementById('resultPanel').classList.add('hidden');
    document.getElementById('syntaxCheck').classList.remove('visible');
    _obfResult = '';
    stats={strings:0,opaque:0};updateStats();setStatus('已清空');
}
function uploadFile(event) {
    var file = event.target.files[0];
    if (!file) return;
    var reader = new FileReader();
    reader.onload = function(e) {
        document.getElementById('inputCode').value = e.target.result;
        document.getElementById('resultPanel').classList.add('hidden');
        _obfResult = '';
        updateStats();
        checkSyntaxLive();
        setStatus('已加载文件: ' + file.name + ' (' + Math.round(file.size/1024*100)/100 + 'KB)', 'success');
    };
    reader.readAsText(file);
    event.target.value = '';
}
function copyOutput() {
    if (!_obfResult) { setStatus('没有内容可复制', 'error'); return; }
    navigator.clipboard.writeText(_obfResult).then(function(){
        setStatus('已复制到剪贴板!', 'success');
    }).catch(function(){
        var ta = document.createElement('textarea');
        ta.value = _obfResult;
        document.body.appendChild(ta);
        ta.select();
        document.execCommand('copy');
        document.body.removeChild(ta);
        setStatus('已复制到剪贴板!', 'success');
    });
}
function downloadOutput() {
    if (!_obfResult) { setStatus('没有内容可下载', 'error'); return; }
    var hash = genHash8();
    var filename = 'obfuscated_' + hash + '.lua';
    var blob = new Blob([_obfResult], {type: 'text/plain'});
    var url = URL.createObjectURL(blob);
    var a = document.createElement('a');
    a.href = url;
    a.download = filename;
    document.body.appendChild(a);
    a.click();
    document.body.removeChild(a);
    URL.revokeObjectURL(url);
    setStatus('文件已下载: ' + filename, 'success');
}

function navigateTo(page) {
    document.querySelectorAll('.page').forEach(function(p) { p.classList.remove('active'); });
    var target = document.getElementById('page-' + page);
    if (target) target.classList.add('active');
    document.querySelectorAll('.nav-link').forEach(function(l) {
        l.classList.toggle('active', l.dataset.page === page);
    });
    window.scrollTo(0, 0);
}

function scrollToFeatures() {
    var el = document.getElementById('featuresSection');
    if (el) el.scrollIntoView({ behavior: 'smooth' });
}

