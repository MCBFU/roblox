function rnd(min, max) {
    randSeed = (randSeed * 1664525 + 1013904223) & 0xffffffff;
    return min + Math.abs(randSeed % (max - min + 1));
}
function pick(arr) { return arr[rnd(0, arr.length - 1)]; }

var _gnameSet = {};
function gname() {
    var charset = 'abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ';
    var name;
    var attempts = 0;



    var len = rnd(7, 16);
    do {
        name = '';
        for (var i = 0; i < len; i++) name += charset.charAt(rnd(0, charset.length - 1));
        attempts++;
        if (attempts > 500) { len++; attempts = 0; }
    } while (_gnameSet[name]);
    _gnameSet[name] = true;
    return name;
}
