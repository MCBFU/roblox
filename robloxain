-- NPC自瞄脚本（增强版：准星右下角修正 + 平滑移动 + 距离无限制）
-- 运行一次：开启，再运行一次：关闭

local player = game:GetService("Players").LocalPlayer
local mouse = player:GetMouse()
local runService = game:GetService("RunService")
local workspace = game:GetService("Workspace")
local camera = workspace.CurrentCamera

if not _G.AIM_STATE then
    _G.AIM_STATE = { enabled = false, conn = nil }
end
local state = _G.AIM_STATE

-- ===== 配置区域（可调整）=====
local OFFSET_X = 32    -- 向右偏移（像素，再调小，更靠左）
local OFFSET_Y = 86    -- 向下偏移（像素，调小，更靠上）
local SMOOTHNESS = 0.3 -- 平滑度（0-1，越小越平滑）
local MAX_DISTANCE = math.huge -- 距离无限制
-- ==============================

local function getHealth(npc)
    local humanoid = npc:FindFirstChild("Humanoid")
    return humanoid and humanoid.Health or 0
end

local function getClosestNPC()
    local char = player.Character
    if not char then return end
    local root = char:FindFirstChild("HumanoidRootPart")
    if not root then return end
    
    local pos = root.Position
    local closest, closestDist = nil, math.huge
    
    for _, obj in pairs(workspace:GetDescendants()) do
        if obj:IsA("Model") and obj ~= char then
            local name = obj.Name or ""
            if string.find(string.lower(name), "robloxian") then
                local humanoid = obj:FindFirstChild("Humanoid")
                local hrp = obj:FindFirstChild("HumanoidRootPart")
                if humanoid and hrp and getHealth(obj) > 0 then
                    local isPlayer = false
                    for _, plr in pairs(game:GetService("Players"):GetPlayers()) do
                        if plr.Character == obj then isPlayer = true break end
                    end
                    if not isPlayer then
                        local dist = (hrp.Position - pos).Magnitude
                        if dist < closestDist and dist <= MAX_DISTANCE then
                            closestDist = dist
                            closest = obj
                        end
                    end
                end
            end
        end
    end
    return closest
end

-- 目标平滑追踪
local targetPosX, targetPosY = 0, 0

local function aim()
    local target = getClosestNPC()
    if not target then return end
    
    local hrp = target:FindFirstChild("HumanoidRootPart")
    if not hrp then return end
    
    local screenPos, onScreen = camera:WorldToScreenPoint(hrp.Position)
    if onScreen then
        -- 计算右下角偏移位置
        targetPosX = screenPos.X + OFFSET_X
        targetPosY = screenPos.Y + OFFSET_Y
        
        -- 平滑移动鼠标（避免抖动）
        local deltaX = (targetPosX - mouse.X) * (1 - SMOOTHNESS)
        local deltaY = (targetPosY - mouse.Y) * (1 - SMOOTHNESS)
        
        if math.abs(deltaX) > 1 or math.abs(deltaY) > 1 then
            mousemoverel(deltaX, deltaY)
        end
    end
end

-- 绘制调试框（可选，帮助确认偏移位置）
local function drawDebugBox()
    local screenGui = player.PlayerGui:FindFirstChild("AimDebug")
    if not screenGui then
        screenGui = Instance.new("ScreenGui")
        screenGui.Name = "AimDebug"
        screenGui.ResetOnSpawn = false
        screenGui.Parent = player.PlayerGui
    end
    
    local box = screenGui:FindFirstChild("TargetBox")
    if not box then
        box = Instance.new("Frame")
        box.Name = "TargetBox"
        box.Size = UDim2.new(0, 20, 0, 20)
        box.AnchorPoint = Vector2.new(0.5, 0.5)
        box.BackgroundTransparency = 0.5
        box.BackgroundColor3 = Color3.fromRGB(255, 0, 0)
        box.BorderSizePixel = 0
        Instance.new("UICorner", box).CornerRadius = UDim.new(1, 0)
        box.Parent = screenGui
    end
    
    box.Position = UDim2.new(0, targetPosX, 0, targetPosY)
end

local function onRender()
    if state.enabled then
        aim()
        drawDebugBox() -- 显示红色调试点
    else
        local screenGui = player.PlayerGui:FindFirstChild("AimDebug")
        if screenGui then screenGui:Destroy() end
    end
end

local function enable()
    if state.conn then state.conn:Disconnect() end
    state.conn = runService.RenderStepped:Connect(onRender)
    state.enabled = true
    print("[自瞄] 已开启 | 偏移: X+" .. OFFSET_X .. " Y+" .. OFFSET_Y .. " | 距离无限制")
    warn("屏幕上会显示红色目标点，帮助你调整偏移位置")
end

local function disable()
    if state.conn then state.conn:Disconnect() end
    state.conn = nil
    state.enabled = false
    local screenGui = player.PlayerGui:FindFirstChild("AimDebug")
    if screenGui then screenGui:Destroy() end
    print("[自瞄] 已关闭")
end

if state.enabled then disable() else enable() end


game:GetService("StarterGui"):SetCore("SendNotification", {
    Title = "MCBFUN",
    Text = "运行开启,再次运行则关闭",
    Icon = "rbxassetid://15608505108", -- 可选：图标ID（这里用个示例笑脸图标）
    Duration = 8, -- 显示时长（秒）
    Position = UDim2.new(0, 20, 1, -50) -- 定位到左下角
})